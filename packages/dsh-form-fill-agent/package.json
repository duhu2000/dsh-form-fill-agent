{
  "name": "dsh-form-fill-agent",
  "version": "0.2.19",
  "private": false,
  "description": "AI form filling and spreadsheet autofill for XLSX in DeepSeek Harness, using authorized Qichacha MCP facts with cell previews, user confirmation and export to a new copy.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duhu2000/dsh-form-fill-agent.git",
    "directory": "packages/dsh-form-fill-agent"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./http": "./lib/http.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "form-fill-core": "0.2.10",
    "qcc-form-fill-provider": "0.2.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "AI填表",
    "AI 填表",
    "自动填表",
    "表格填充",
    "表格补全",
    "Excel填表",
    "Excel回填",
    "form filling",
    "spreadsheet autofill",
    "企查查MCP",
    "企查查 MCP",
    "form-filling",
    "spreadsheet-autofill",
    "xlsx",
    "enterprise-data"
  ]
}
